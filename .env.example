# =============================================================================
# ReachInbox Email Scheduler - Environment Variables
# =============================================================================
# Copy this file to .env and fill in actual values. NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Elasticsearch (Search indexing)
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# Google OAuth (Required for authentication)
# -----------------------------------------------------------------------------
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Session (Express session with cookies)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=reachinbox.sid

# -----------------------------------------------------------------------------
# Slack OAuth (Required for rate-limit notifications)
# -----------------------------------------------------------------------------
# Create at: https://api.slack.com/apps
# Redirect URL: http://localhost:4000/api/integrations/slack/callback
# Scopes: chat:write, channels:read, groups:read, im:read, mpim:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/integrations/slack/callback

# -----------------------------------------------------------------------------
# Token Encryption (For Slack bot tokens, SMTP credentials at rest)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (must be exactly 32 bytes / 64 hex chars)
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-key-64-chars

# -----------------------------------------------------------------------------
# Ethereal Email (Fake SMTP for testing)
# -----------------------------------------------------------------------------
# Create accounts at: https://ethereal.email/create
# Multiple senders can be configured via seed script or env
ETHEREAL_FROM_NAME=ReachInbox Demo

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=10
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_WINDOW=UTC_FIXED_HOUR
EMAIL_JOB_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=5000

# -----------------------------------------------------------------------------
# CSV Upload Limits
# -----------------------------------------------------------------------------
CSV_MAX_BYTES=5242880

# -----------------------------------------------------------------------------
# Bull Board (Queue Dashboard) - Admin Access
# -----------------------------------------------------------------------------
# Set to comma-separated list of admin user emails (from Google OAuth)
BULL_BOARD_ADMIN_EMAILS=admin@example.com

# -----------------------------------------------------------------------------
# Elasticsearch Index
# -----------------------------------------------------------------------------
ELASTICSEARCH_INDEX=scheduled-emails-v1