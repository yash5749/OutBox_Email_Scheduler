{
  "name": "@reachinbox/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --ignore-pattern '*.ts' || true",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "es:reindex": "tsx src/scripts/es-reindex.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.9.14",
    "slack-web-api-client": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
